{
  "name": "@devadri/create-sticker",
  "version": "1.2.1",
  "private": true,
  "author": "Adrián Bueno <devadri.com>",
  "license": "Unlicense",
  "description": "Library that adds a sticker effect to images with transparent backgrounds",
  "homepage": "https://github.com/adrian-bueno/create-sticker",
  "main": "bundle.cjs.js",
  "module": "bundle.esm.mjs",
  "unpkg": "bundle.iife.js",
  "jsdelivr": "bundle.iife.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./bundle.esm.mjs",
      "require": "./bundle.cjs.js",
      "default": "./bundle.esm.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian-bueno/create-sticker.git"
  },
  "keywords": [
    "sticker",
    "stickers",
    "border",
    "image",
    "png",
    "webp",
    "effect",
    "create",
    "javascript",
    "angular",
    "react",
    "vue",
    "browser",
    "editor",
    "image-editor"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "release": "cd dist && npm publish",
    "demo": "http-server -p 3000 -c-1 -o demo/index.html"
  },
  "files": [
    "*"
  ],
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.5",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
